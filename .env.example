# --- AI keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TEXT_MODEL=claude-sonnet-5-5
QC_MODEL=claude-haiku-5-5
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium

# --- Instagram (official Graph API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com for Facebook-Login tokens, graph.instagram.com for Instagram-Login tokens
GRAPH_HOST=https://graph.facebook.com
GRAPH_VERSION=v26.0
AI_DISCLOSURE=true

# --- Public image hosting (S3-compatible: S3, Cloudflare R2, MinIO) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
PUBLIC_BASE_URL=https://cdn.example.com

# --- Behaviour ---
REQUIRE_APPROVAL=true
DRY_RUN=false
